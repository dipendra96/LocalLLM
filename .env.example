# Server bind address (loopback by default).
UVICORN_HOST=127.0.0.1

OLLAMA_URL=http://127.0.0.1:11434
LOCALCHAT_DATA=data
LOCALCHAT_MODEL=gemma4:e2b
# Requested Ollama context allocation: 128k tokens.
LOCALCHAT_CONTEXT_TOKENS=131072
LOCALCHAT_MCP_CONFIG=mcp.toml
# Compact above this observed prompt size; 0 disables compaction.
LOCALCHAT_COMPACTION_TOKENS=50000
# Recent raw events to retain (events are not the same as turns).
LOCALCHAT_COMPACTION_RETENTION=8
